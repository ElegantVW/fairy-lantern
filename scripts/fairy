#!/usr/bin/env bash
# fairy — thin launcher + optional auto-rebuild of the source tree
# Discovery: FAIRY_BIN → source tree (rebuild if newer) → ~/.local/lib/faeos/fairy
set -euo pipefail

if [[ -n "${FAIRY_BIN:-}" && -x "${FAIRY_BIN}" ]]; then
  exec "$FAIRY_BIN" "$@"
fi

ROOT="${FAIRY_LANTERN_ROOT:-$HOME/fairy-lantern}"
if [[ ! -d "$ROOT/src" || ! -f "$ROOT/Cargo.toml" ]]; then
  here="$(cd "$(dirname "$0")" && pwd)"
  if [[ -d "$here/../src" && -f "$here/../Cargo.toml" ]]; then
    ROOT="$(cd "$here/.." && pwd)"
  else
    ROOT=""
  fi
fi

LIB_BIN="$HOME/.local/lib/faeos/fairy"

# No source tree: use installed engine only
if [[ -z "$ROOT" || ! -f "$ROOT/Cargo.toml" ]]; then
  if [[ -x "$LIB_BIN" ]]; then
    exec "$LIB_BIN" "$@"
  fi
  echo "fairy: engine not built yet (no source tree, no ~/.local/lib/faeos/fairy)." >&2
  echo "  build:  git clone git@github.com:ElegantVW/fairy-lantern.git ~/fairy-lantern" >&2
  echo "          cd ~/fairy-lantern && ./build.sh install" >&2
  exit 127
fi

BIN="$ROOT/target/release/fairy"
need=0
if [[ ! -x "$BIN" ]]; then
  need=1
else
  newest="$(find "$ROOT/src" "$ROOT/Cargo.toml" "$ROOT/Cargo.lock" \
    -type f -printf '%T@\n' 2>/dev/null | sort -n | tail -1)"
  built="$(stat -c '%Y' "$BIN" 2>/dev/null || echo 0)"
  newest_i="${newest%.*}"
  if [[ -n "$newest_i" && "$newest_i" -gt "$built" ]]; then
    need=1
  fi
fi

# Real cargo JSON → crate counts / names. Not a timed fake bar.
cargo_progress() {
  python3 -u <<'PY'
import json, os, sys

tty = os.isatty(2)
width = 28
compiled = 0
cached = 0
try:
    expected = max(1, int(os.environ.get("FAIRY_CRATE_TOTAL", "0")))
except ValueError:
    expected = 1


def crate_name(msg):
    tgt = (msg.get("target") or {}).get("name")
    if tgt:
        return tgt
    pid = msg.get("package_id") or ""
    if "#" in pid:
        return pid.rsplit("#", 1)[-1]
    return pid.split(" ", 1)[0] or "crate"


def bar(done, total):
    total = max(total, 1)
    fill = min(width, int(round(width * min(done, total) / total)))
    if tty:
        return "█" * fill + "░" * (width - fill)
    return "#" * fill + "-" * (width - fill)


def draw(suffix):
    done = compiled + cached
    total = max(expected, done)
    line = (
        f"  [{bar(done, total)}] {done}/{total}  "
        f"{compiled} compiled · {cached} cached  {suffix}"
    )
    if tty:
        sys.stderr.write("\r\033[K" + line[:140])
    else:
        sys.stderr.write(line + "\n")
    sys.stderr.flush()


ok = False
for raw in sys.stdin:
    raw = raw.strip()
    if not raw:
        continue
    try:
        msg = json.loads(raw)
    except json.JSONDecodeError:
        continue
    reason = msg.get("reason")
    if reason == "compiler-artifact":
        name = crate_name(msg)
        if msg.get("fresh"):
            cached += 1
        else:
            compiled += 1
        draw(name)
    elif reason == "compiler-message":
        rendered = (msg.get("message") or {}).get("rendered")
        if rendered:
            if tty:
                sys.stderr.write("\n")
            sys.stderr.write(rendered)
            if not rendered.endswith("\n"):
                sys.stderr.write("\n")
            sys.stderr.flush()
    elif reason == "build-finished":
        ok = bool(msg.get("success"))

if tty:
    sys.stderr.write("\n")
draw("ok" if ok else "FAILED")
if tty:
    sys.stderr.write("\n")
sys.exit(0 if ok else 1)
PY
}

if [[ "$need" -eq 1 ]]; then
  echo "✦ fairy: compiling release (source newer than binary)…" >&2
  echo "  cargo is working — counts are crates from this build, not a timer." >&2
  crate_total="$(
    cd "$ROOT" && cargo metadata --format-version 1 --offline 2>/dev/null \
      | python3 -c 'import json,sys; print(len(json.load(sys.stdin).get("packages") or []))' \
      2>/dev/null || echo 0
  )"
  export FAIRY_CRATE_TOTAL="$crate_total"
  set +e
  set +o pipefail
  set +u
  (cd "$ROOT" && CARGO_TERM_PROGRESS_WHEN=never cargo build --release --quiet --message-format=json --color=always) \
    | cargo_progress
  ps=("${PIPESTATUS[@]}")
  st="${ps[0]:-1}"
  py="${ps[1]:-1}"
  set -euo pipefail
  if [[ "$st" -eq 141 ]]; then
    st="$py"
  fi
  if [[ "$st" -ne 0 || "$py" -ne 0 ]]; then
    echo "✦ fairy: compile failed — rustc output follows" >&2
    if ! (cd "$ROOT" && cargo build --release); then
      echo "fairy: build failed ($BIN missing)" >&2
      exit 1
    fi
  fi
  echo "✦ fairy: build ok — starting" >&2
fi

if [[ -x "$BIN" ]]; then
  exec "$BIN" "$@"
fi

if [[ -x "$LIB_BIN" ]]; then
  exec "$LIB_BIN" "$@"
fi

echo "fairy: build failed ($BIN missing)" >&2
echo "  build:  cd ~/fairy-lantern && ./build.sh install" >&2
exit 1
